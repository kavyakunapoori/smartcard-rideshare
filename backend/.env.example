# =============================================================================
# Smart Carpool and Ride Sharing System - Backend Environment Configuration
# =============================================================================

# Server Port (Render automatically sets $PORT in production)
PORT=8080

# -----------------------------------------------------------------------------
# MySQL Database Connection Settings
# -----------------------------------------------------------------------------
# Local Development:
# Database name must be: smart_carpool
# Example URL with standard parameters for MySQL 8.x:
DB_URL=jdbc:mysql://localhost:3306/smart_carpool?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Hosted MySQL / Production (e.g., TiDB Cloud, Aiven, Railway, AWS RDS, PlanetScale):
# Set DB_URL, DB_USERNAME, and DB_PASSWORD from your provider's connection panel.
# Or provide the full connection URI via DATABASE_URL:
# DATABASE_URL=mysql://username:password@hostname:3306/smart_carpool?sslMode=REQUIRED

# -----------------------------------------------------------------------------
# Security & JWT Configuration
# -----------------------------------------------------------------------------
# JWT Secret Key (Generate a random 32+ character key for production)
JWT_SECRET=productionjwtsecretkey2026supersecuredefaultsigningkeywithmin256bitslength
JWT_EXPIRATION_MS=86400000

# -----------------------------------------------------------------------------
# CORS Allowed Frontend Origins (Comma-separated)
# -----------------------------------------------------------------------------
# In production, set to your Vercel URL: https://your-project.vercel.app
FRONTEND_URL=http://localhost:5173,http://localhost:3000
